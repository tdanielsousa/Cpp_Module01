#*********************************************#
#****              sources                ****#
#*********************************************#

SRCS    = Zombie.cpp \
          main.cpp \
          zombieHorde.cpp

#*********************************************#
#****         Compiler and flags          ****#
#*********************************************#

CXX      = c++

CXXFLAGS = -Wall -Wextra -Werror -g3 -std=c++98

#*****************************************#
#****          Binary name           *****#
#*****************************************#

NAME = ex01


#*****************************************************#
#***  Remove, binary name, substitute .cpp for .o ****#
#*****************************************************#

RM   = rm -f

OBJS = ${SRCS:.cpp=.o}


#*********************************************#
#****    Compile .cpp files to .o         ****#
#*********************************************#

%.o: %.cpp
	$(CXX) $(CXXFLAGS) -c $< -o $@


#*********************************************#
#****              Targets                ****#
#*********************************************#

all: $(NAME)

$(NAME): $(OBJS)
	$(CXX) $(CXXFLAGS) $(OBJS) -o $(NAME)
	@echo "\033[1;35m************************************************************\033[0m"
	@echo "\033[1;36m  >>>>>>> The program was successfully built <<<<<<<<\033[0m"
	@echo "\033[1;35m************************************************************\033[0m"

clean:
	$(RM) $(OBJS)
	@echo "\033[1;35m**************************************************************\033[0m"
	@echo "\033[1;36m  >>>>>>> Objects were successfully removed <<<<<<<<\033[0m"
	@echo "\033[1;35m**************************************************************\033[0m"

fclean: clean
	$(RM) $(NAME)
	@echo "\033[1;35m*****************************************************\033[0m"
	@echo "\033[1;36m  >>>>>>> Program successfully removed <<<<<<<<\033[0m"
	@echo "\033[1;35m*****************************************************\033[0m"

re: fclean all
	@echo "\033[1;35m***********************************************\033[0m"
	@echo "\033[1;36m  >>>>>>> Re-do successful <<<<<<<<\033[0m"
	@echo "\033[1;35m***********************************************\033[0m"


#*********************************************#
#****             Help target              ****#
#*********************************************#

help:
	@echo "\033[1;35m************************************************************************\033[0m"
	@echo " \033[1;35m>>>>>>> Available targets: <<<<<<<<\033[0m"
	@echo "\033[1;33m >>>>>>>  all      - Build the program <<<<<<<\033[0m"
	@echo "\033[1;33m >>>>>>>  clean    - Remove object files <<<<<<<<\033[0m"
	@echo "\033[1;33m >>>>>>>  fclean   - Remove object files and binary <<<<<<<<\033[0m"
	@echo "\033[1;33m >>>>>>>  re       - Rebuild the program <<<<<<<<\033[0m"
	@echo "\033[1;33m >>>>>>>  help     - See all targets <<<<<<<<\033[0m"
	@echo "\033[1;35m************************************************************************\033[0m"

.PHONY: all clean fclean re help
